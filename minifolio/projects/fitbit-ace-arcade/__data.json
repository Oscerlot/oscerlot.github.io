ion":271,"Filter":272,"Interlace":273,"Pixels Per Unit X":274,"Pixels Per Unit Y":277,"Pixel Units":278},{"value":266,"description":267},1080,"1080px",{"value":266,"description":267},{"value":65,"description":66},{"value":105,"description":123},{"value":71,"description":72},{"value":71,"description":74},{"value":71,"description":76},{"value":275,"description":276},2835,"2835",{"value":275,"description":276},{"value":93,"description":132},{"Image Width":265,"Image Height":268,"Bit Depth":269,"Color Type":270,"Compression":271,"Filter":272,"Interlace":273},{"FileType":281},{"value":83,"description":84}],"uses":{"params":["slug"]}}]}
